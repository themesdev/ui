---
// Put in <head>, before your stylesheet: sets the "dark" class on <html> before the first paint, so a visitor who
// chose dark never sees a light flash. Light is the default; the system setting is followed until they choose.
---

<script is:inline>
  try {
    const t = localStorage.getItem('theme');
    document.documentElement.classList.toggle('dark', t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
  } catch (e) {}
</script>
